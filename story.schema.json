{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "whyshorts/story.schema.json",
 "title": "WhyShorts story.json",
 "description": "One video, frame-based. See STORY.md. Values may be numbers or safe math expressions (strings) evaluated per frame.",
 "type": "object",
 "required": [
  "meta",
  "camera"
 ],
 "additionalProperties": false,
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "fps",
    "frames"
   ],
   "additionalProperties": false,
   "properties": {
    "title": {
     "type": "string"
    },
    "slug": {
     "type": "string"
    },
    "fps": {
     "type": "integer",
     "enum": [
      24,
      25,
      30,
      60
     ]
    },
    "frames": {
     "type": "integer",
     "minimum": 1
    },
    "seed": {
     "type": "integer"
    },
    "voice": {
     "type": "string"
    },
    "output": {
     "type": "string"
    },
    "samples": {
     "type": "integer",
     "minimum": 1
    },
    "aspect": {
     "enum": [
      "9:16",
      "16:9"
     ],
     "description": "9:16 = Shorts 1080x1920 (default); 16:9 = long-form YouTube 1920x1080"
    },
    "chapter": {
     "type": "object",
     "additionalProperties": false,
     "description": "long-form: this story is one chapter of a longer video",
     "properties": {
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "title": {
       "type": "string"
      },
      "start_sec": {
       "type": "number",
       "description": "where this chapter starts in the project's full voice.wav"
      }
     }
    }
   }
  },
  "defs": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   },
   "description": "named helpers, usually 'lambda f: ...'"
  },
  "consts": {
   "type": "object",
   "additionalProperties": {
    "type": "number"
   }
  },
  "world": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "sky": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/rgb"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "sky_strength": {
     "type": "number"
    },
    "sun": {
     "type": "object",
     "properties": {
      "energy": {
       "type": "number"
      },
      "color": {
       "$ref": "#/$defs/rgb"
      },
      "angle_deg": {
       "type": "number"
      },
      "rot_deg": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
      }
     },
     "additionalProperties": false
    }
   }
  },
  "sets": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/set"
   }
  },
  "camera": {
   "oneOf": [
    {
     "$ref": "#/$defs/camera_v2"
    },
    {
     "$ref": "#/$defs/camera_v3"
    },
    {
     "$ref": "#/$defs/camera_long"
    }
   ]
  },
  "chars": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/char"
   }
  },
  "visibility": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/ranges"
   }
  },
  "tracks": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/track"
   }
  },
  "words": {
   "type": "array",
   "items": {
    "type": "array",
    "prefixItems": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ],
    "minItems": 2,
    "maxItems": 2
   }
  },
  "captions": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "highlight": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "impact": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "burst_word": {
     "type": [
      "string",
      "null"
     ]
    },
    "lift": {
     "$ref": "#/$defs/ranges"
    },
    "style": {
     "enum": [
      "pop",
      "bottom",
      "off"
     ],
     "description": "pop = Shorts word-by-word (default for 9:16); bottom = phrase subtitles at the bottom (default for 16:9); off"
    },
    "y": {
     "type": "number",
     "minimum": -1,
     "maximum": 1,
     "description": "bottom style: screen y of the line (default -0.80)"
    },
    "size": {
     "type": "number",
     "minimum": 0.015,
     "maximum": 0.08,
     "description": "bottom style: letter height (default 0.034)"
    }
   }
  },
  "fx": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "dust": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "frame",
       "pos"
      ],
      "additionalProperties": false,
      "properties": {
       "frame": {
        "type": "integer"
       },
       "pos": {
        "$ref": "#/$defs/vec3"
       },
       "n": {
        "type": "integer"
       },
       "radius": {
        "type": "number"
       },
       "size": {
        "type": "number"
       },
       "life": {
        "type": "integer"
       },
       "rise": {
        "type": "number"
       }
      }
     }
    }
   }
  },
  "teleport_holds": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sound": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "music": {
     "anyOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "mood": {
         "enum": [
          "calm",
          "epic",
          "march",
          "mystery",
          "playful",
          "sad",
          "sneaky",
          "tense",
          "triumph"
         ]
        },
        "gain": {
         "type": "number"
        },
        "gain_with_voice": {
         "type": "number"
        },
        "duck": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        },
        "duck_window": {
         "type": "array",
         "items": {
          "type": "integer"
         },
         "minItems": 2,
         "maxItems": 2
        },
        "file": {
         "type": "string",
         "description": "long-form: file in library/music/ (royalty-free); loops/trims to fit"
        },
        "gain_db": {
         "type": "number",
         "description": "long-form: music level relative to the voice (default -4; ducked while the voice speaks)"
        },
        "duck_db": {
         "type": "number",
         "description": "long-form: extra drop while the voice speaks (default -10)"
        },
        "seed": {
         "type": "integer"
        },
        "intensity": {
         "type": "number",
         "minimum": 0.2,
         "maximum": 1.5
        },
        "from": {
         "type": "integer"
        },
        "to": {
         "type": "integer"
        },
        "note": {
         "type": "string"
        }
       }
      },
      {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "mood": {
          "enum": [
           "calm",
           "epic",
           "march",
           "mystery",
           "playful",
           "sad",
           "sneaky",
           "tense",
           "triumph"
          ]
         },
         "gain": {
          "type": "number"
         },
         "gain_with_voice": {
          "type": "number"
         },
         "duck": {
          "type": "array",
          "items": {
           "type": "integer"
          }
         },
         "duck_window": {
          "type": "array",
          "items": {
           "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
         },
         "file": {
          "type": "string",
          "description": "long-form: file in library/music/ (royalty-free); loops/trims to fit"
         },
         "gain_db": {
          "type": "number",
          "description": "long-form: music level relative to the voice (default -4; ducked while the voice speaks)"
         },
         "duck_db": {
          "type": "number",
          "description": "long-form: extra drop while the voice speaks (default -10)"
         },
         "seed": {
          "type": "integer"
         },
         "intensity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1.5
         },
         "from": {
          "type": "integer"
         },
         "to": {
          "type": "integer"
         },
         "note": {
          "type": "string"
         }
        }
       },
       "description": "long-form: music segments (mood or file, from, to); 2 s crossfades"
      }
     ]
    },
    "ambience": {
     "anyOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "kind": {
         "enum": [
          "battlefield",
          "camp",
          "city",
          "fire",
          "forest",
          "market",
          "night",
          "none",
          "rain",
          "river",
          "room",
          "sea",
          "swamp",
          "wind"
         ]
        },
        "gain": {
         "type": "number"
        },
        "gain_db": {
         "type": "number",
         "description": "long-form: relative to the voice (default -20)"
        },
        "from": {
         "type": "integer"
        },
        "to": {
         "type": "integer"
        },
        "note": {
         "type": "string"
        }
       }
      },
      {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "kind": {
          "enum": [
           "battlefield",
           "camp",
           "city",
           "fire",
           "forest",
           "market",
           "night",
           "none",
           "rain",
           "river",
           "room",
           "sea",
           "swamp",
           "wind"
          ]
         },
         "gain": {
          "type": "number"
         },
         "gain_db": {
          "type": "number",
          "description": "long-form: relative to the voice (default -20)"
         },
         "from": {
          "type": "integer"
         },
         "to": {
          "type": "integer"
         },
         "note": {
          "type": "string"
         }
        }
       }
      }
     ]
    },
    "sfx_gain_with_voice": {
     "type": "number"
    },
    "auto": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "avoid": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "gesture_chars": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    "events": {
     "type": "array",
     "items": {
      "type": "array",
      "prefixItems": [
       {
        "type": "integer"
       },
       {
        "$ref": "#/$defs/sfx"
       },
       {
        "type": "number"
       }
      ],
      "minItems": 3,
      "maxItems": 3
     }
    },
    "repeat": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "from",
       "to",
       "every",
       "gain"
      ],
      "additionalProperties": false,
      "properties": {
       "name": {
        "$ref": "#/$defs/sfx"
       },
       "from": {
        "type": "integer"
       },
       "to": {
        "type": "integer"
       },
       "every": {
        "type": "integer",
        "minimum": 1
       },
       "gain": {
        "type": "number"
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "master": {
     "type": "object",
     "additionalProperties": false,
     "description": "long-form mix: voice compression, ducking, loudness target",
     "properties": {
      "lufs": {
       "type": "number",
       "minimum": -24,
       "maximum": -9
      },
      "compress_voice": {
       "type": "boolean"
      },
      "sfx_db": {
       "type": "number"
      }
     }
    }
   }
  },
  "notes": {},
  "cards": {
   "type": "array",
   "description": "on-screen cards parented to the camera (title cards, labels, ✗/✓ stamps, thought bubbles, iris-out); long-form: fade (to/from black) and chapter (dark plate + chapter title)",
   "items": {
    "type": "object",
    "required": [
     "style",
     "from",
     "to"
    ],
    "additionalProperties": false,
    "properties": {
     "style": {
      "enum": [
       "title",
       "label",
       "stamp_x",
       "stamp_check",
       "bubble",
       "iris",
       "fade",
       "chapter",
       "screen"
      ]
     },
     "text": {
      "type": "string"
     },
     "from": {
      "type": "integer"
     },
     "to": {
      "type": "integer"
     },
     "pos": {
      "type": "array",
      "items": {
       "type": "number",
       "minimum": -1.2,
       "maximum": 1.2
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "screen x,y in -1..1 (y=1 top)"
     },
     "size": {
      "type": "number",
      "minimum": 0.03,
      "maximum": 0.3,
      "description": "letter height in scene units at the captions depth (frame is 1.29 tall): title 0.075, label 0.06, bubble 0.065, stamps 0.16. NOT a multiplier."
     },
     "color": {
      "$ref": "#/$defs/rgb"
     },
     "rot": {
      "type": "number",
      "description": "degrees"
     },
     "note": {
      "type": "string"
     },
     "sub": {
      "type": "string",
      "description": "chapter/screen: small line above the big text, e.g. 'CHAPTER 2' or 'THE YEAR IS'"
     },
     "in": {
      "type": "integer",
      "minimum": 0,
      "description": "fade/chapter: frames to fade in"
     },
     "out": {
      "type": "integer",
      "minimum": 0,
      "description": "fade/chapter: frames to fade out"
     },
     "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "chapter: plate opacity (default 0.94)"
     },
     "hold": {
      "type": "boolean",
      "description": "fade: stay black after 'to' (end of video)"
     },
     "faction": {
      "type": "string",
      "description": "(planned) take colours from this faction"
     },
     "variant": {
      "enum": [
       "year",
       "number",
       "question",
       "quote",
       "name",
       "place",
       "fact"
      ],
      "description": "screen: layout of the key-moment text screen"
     },
     "caption": {
      "type": "string",
      "description": "screen: small line under the big text"
     }
    }
   }
  },
  "factions": {
   "type": "array",
   "description": "(long-form, planned) sides/nations in this video; outfits and colours come from the culture",
   "items": {
    "type": "object",
    "required": [
     "id"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "culture": {
      "type": "string"
     },
     "color": {
      "$ref": "#/$defs/rgb"
     },
     "emblem": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "crowds": {
   "type": "array",
   "description": "formations of soldiers/people: a few template characters instanced at every position",
   "items": {
    "type": "object",
    "required": [
     "id"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "faction": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "outfit": {
      "type": "string"
     },
     "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 400
     },
     "formation": {
      "enum": [
       "block",
       "line",
       "column",
       "wedge",
       "scatter",
       "circle"
      ]
     },
     "cols": {
      "type": "integer",
      "minimum": 1
     },
     "spacing": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "stagger": {
      "type": "boolean"
     },
     "jitter": {
      "type": "number"
     },
     "radius": {
      "type": "number"
     },
     "area": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "at": {
      "$ref": "#/$defs/vec3"
     },
     "rot": {
      "type": "number",
      "description": "degrees around Z; members stand in rows along +Y (away from a camera on -Y)"
     },
     "variants": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
     },
     "seed": {
      "type": "integer"
     },
     "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "seed": {
        "type": "integer"
       },
       "hair": {
        "enum": [
         "none",
         "short",
         "long",
         "tied",
         "curly",
         "topknot",
         "braids",
         "bald_sides"
        ]
       },
       "beard": {
        "enum": [
         "none",
         "mustache",
         "full",
         "goatee"
        ]
       },
       "hair_color": {
        "$ref": "#/$defs/rgb"
       },
       "accent": {
        "$ref": "#/$defs/rgb"
       },
       "skin_mode": {
        "enum": [
         "cartoon",
         "tones"
        ]
       },
       "skin": {
        "$ref": "#/$defs/rgb"
       }
      }
     },
     "face": {
      "type": "string"
     },
     "pose": {
      "type": "object",
      "description": "default pose of every member (armL/armR/legs/tilt ...)"
     },
     "moves": {
      "type": "array",
      "items": {
       "type": "array"
      },
      "description": "[[frame, [x, y]], ...] the whole formation moves"
     },
     "ease": {
      "type": "boolean"
     },
     "march": {
      "$ref": "#/$defs/ranges"
     },
     "from": {
      "type": "integer"
     },
     "to": {
      "type": "integer"
     },
     "note": {
      "type": "string"
     },
     "faces": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "expressions spread over the variants"
     }
    }
   }
  },
  "vfx": {
   "type": "array",
   "description": "long-form effects: smoke, dust, fire, arrows, sparks, banner, light_shafts, rain, snow",
   "items": {
    "type": "object",
    "required": [
     "type"
    ],
    "properties": {
     "type": {
      "enum": [
       "smoke",
       "dust",
       "fire",
       "arrows",
       "sparks",
       "banner",
       "light_shafts",
       "rain",
       "snow"
      ]
     },
     "at": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "from": {
      "type": "integer"
     },
     "to": {
      "type": "integer"
     },
     "frame": {
      "type": "integer"
     },
     "n": {
      "type": "integer"
     },
     "size": {
      "type": "number"
     },
     "spread": {
      "type": "number"
     },
     "color": {
      "$ref": "#/$defs/rgb"
     },
     "opacity": {
      "type": "number"
     },
     "life": {
      "type": "integer"
     },
     "rise": {
      "type": "number"
     },
     "wind": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "array",
        "items": {
         "type": "number"
        }
       }
      ]
     },
     "tongues": {
      "type": "integer"
     },
     "embers": {
      "type": "integer"
     },
     "smoke": {
      "type": "boolean"
     },
     "from_at": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "to_at": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "dur": {
      "type": "integer"
     },
     "arc": {
      "type": "number"
     },
     "stagger": {
      "type": "integer"
     },
     "stick": {
      "type": "boolean"
     },
     "faction": {
      "type": "string"
     },
     "h": {
      "type": "number"
     },
     "w": {
      "type": "number"
     },
     "fh": {
      "type": "number"
     },
     "rot": {
      "type": "number"
     },
     "dir": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "length": {
      "type": "number"
     },
     "intensity": {
      "type": "number"
     },
     "note": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "value": {
   "type": [
    "number",
    "string"
   ],
   "description": "number or expression string"
  },
  "vec3": {
   "type": [
    "array",
    "string"
   ],
   "items": {
    "$ref": "#/$defs/value"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "rgb": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 1
   },
   "minItems": 3,
   "maxItems": 3
  },
  "range": {
   "type": "array",
   "items": {
    "type": "integer"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "ranges": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/range"
   }
  },
