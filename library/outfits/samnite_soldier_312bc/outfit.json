{
 "name": "samnite_soldier_312bc",
 "culture": "samnite_312bc",
 "role": "soldier",
 "title_vi": "Chiến binh Samnite (~312 TCN)",
 "description_vi": "Tunic ngắn tới giữa đùi màu phe (xanh lam đậm), viền cổ và gấu trắng ngà; giáp ngực ba đĩa đồng xếp tam giác, mỗi đĩa có vòng sẫm và núm giữa, nối bằng đai vai da; thắt lưng đồng rộng có hai móc hình lá ở giữa; mũ đồng kiểu Attic/Montefortino: chỏm tròn, gờ trán, vành gáy nhỏ, miếng che má có ba núm, hai ống cắm hai bên mỗi bên một lông vũ trắng to cao cong ra ngoài, mào ngắn màu phe trên đỉnh; xà cạp đồng ở chân trái (Livy 9.40); khiên tròn lớn màu phe, vành và núm đồng (tay trái); giáo dài mũi lá đồng, cán gỗ (tay phải); dép da.",
 "silhouette_vi": "hai lông vũ trắng to dựng cao hình chữ V trên mũ + ba đĩa đồng tròn trên ngực + khiên tròn lớn + giáo dài vượt đầu (khác La Mã: mũ gờ gáy rộng/mào ngang, khiên chữ nhật, pilum)",
 "sources": [
  {
   "claim": "Giáp ngực ba đĩa đồng xuất phát từ vùng Apennine trung bộ/Samnium cuối thế kỷ 5 TCN (Alfedena)",
   "source": "Burns, M. T., 'The Cultural Impact of Bronze Armour in Italy' (UCL, 2005)"
  },
  {
   "claim": "Thắt lưng đồng rộng có móc gắn với chiến binh trưởng thành",
   "source": "The Metropolitan Museum of Art, 'Bronze belt and clasps', acc. 08.3a"
  },
  {
   "claim": "Mũ Attic, giáp ba đĩa, xà cạp trong bộ giáp Ý",
   "source": "Museo Archeologico Nazionale di Paestum; Mougins Museum of Classical Art MMoCA840"
  },
  {
   "claim": "Mũ có mào để trông cao hơn; xà cạp chân trái",
   "source": "Livy, Ab Urbe Condita 9.40"
  },
  {
   "claim": "Mũ Ý thế kỷ 4 TCN có ống cắm lông vũ hai bên và chốt mào giữa; chiến binh Osca vác giáo",
   "source": "Burns 2005; Connolly, 'Greece and Rome at War' (1981); tranh mộ Andriuolo 12, Paestum"
  },
  {
   "claim": "Màu xanh lam là lựa chọn nhận diện phe, không có sử liệu; khiên tròn là một trong các dạng khiên (khiên thon dưới theo Livy còn tranh cãi)",
   "source": "culture.json samnite_312bc, mục uncertain_vi"
  }
 ],
