 "segments": [
  {
   "start": 0.0,
   "end": 1.78,
   "text": "A three-hundred-pound iron lid."
  },
  {
   "start": 2.06,
   "end": 3.42,
   "text": "A perfectly good hole."
  },
  {
   "start": 3.7,
   "end": 7.08,
   "text": "And a worker named Sam, about to have a very bad day."
  },
  {
   "start": 7.52,
   "end": 7.82,
   "text": "Joe?"
  },
  {
   "start": 8.12,
   "end": 9.4,
   "text": "Why is it getting dark?\""
  },
  {
   "start": 9.88,
   "end": 10.34,
   "text": "CLANG!"
  },
  {
   "start": 10.7,
   "end": 13.52,
   "text": "To understand how we got here, let's go back."
  },
  {
   "start": 13.84,
   "end": 20.0,
   "text": "Back to a simple question that has scared job applicants for decades: why are manhole covers round?"
  },
  {
   "start": 20.3,
   "end": 21.08,
   "text": "Not square."
  },
  {
   "start": 21.36,
   "end": 22.26,
   "text": "Not triangle. Round."
  },
  {
   "start": 22.6,
   "end": 25.26,
   "text": "Almost every one you walk over."
  },
  {
   "start": 25.58,
   "end": 26.54,
   "text": "That's suspicious."
  },
  {
   "start": 26.84,
   "end": 29.8,
   "text": "Somebody decided this. And three days ago,"
  },
  {
   "start": 29.98,
   "end": 32.08,
   "text": "one man decided to undecide it."
  },
  {
   "start": 32.38,
   "end": 32.96,
   "text": "Meet Gary."
  },
  {
   "start": 33.26,
   "end": 34.12,
   "text": "Budget manager."
  },
  {
   "start": 34.42,
   "end": 35.22,
   "text": "Hates waste."
  },
  {
   "start": 35.52,
   "end": 36.48,
   "text": "Loves squares."
  },
  {
   "start": 36.92,
   "end": 39.08,
   "text": "Round covers waste space on the truck,\""
  },
  {
   "start": 39.36,
   "end": 40.04,
   "text": "Gary says."
  },
  {
   "start": 40.48,
   "end": 41.38,
   "text": "Squares stack."
  },
  {
   "start": 41.68,
   "end": 42.9,
   "text": "Squares save money."
  },
  {
   "start": 43.2,
   "end": 44.48,
   "text": "Squares are the future!\""
  },
  {
   "start": 44.98,
   "end": 46.94,
   "text": "He orders five hundred of them."
  },
  {
   "start": 47.22,
   "end": 48.12,
   "text": "On his phone."
  },
  {
   "start": 48.42,
   "end": 49.72,
   "text": "Without asking anyone."
  },
  {
   "start": 50.0,
   "end": 50.88,
   "text": "Now meet Joe."
  },
  {
   "start": 51.18,
   "end": 54.72,
   "text": "Joe installs manhole covers, and he is very proud of it."
  },
  {
   "start": 55.02,
   "end": 57.16,
   "text": "Joe does not like where this is going."
  },
  {
   "start": 57.62,
   "end": 57.98,
   "text": "Boss,"
  },
  {
   "start": 58.2,
   "end": 59.44,
   "text": "the round ones work.\""
  },
  {
   "start": 59.96,
   "end": 60.64,
   "text": "Exactly,\""
  },
  {
   "start": 60.98,
   "end": 61.62,
   "text": "says Gary."
  },
  {
   "start": 62.04,
   "end": 62.46,
   "text": "Boring.\""
  },
  {
   "start": 62.9,
   "end": 64.14,
   "text": "Then the bill arrives."
  },
  {
   "start": 64.42,
   "end": 65.22,
   "text": "It is long."
  },
  {
   "start": 65.52,
   "end": 66.28,
   "text": "Very long."
  },
  {
   "start": 66.58,
   "end": 67.38,
   "text": "Gary smiles."
  },
  {
   "start": 67.7,
   "end": 68.4,
   "text": "Joe gulps."
  },
  {
   "start": 68.7,
   "end": 69.24,
   "text": "Day one."
  },
  {
   "start": 69.54,
   "end": 72.36,
   "text": "Joe lifts the first square cover over the hole."
  },
  {
   "start": 72.64,
   "end": 73.34,
   "text": "It wobbles,"
  },
  {
   "start": 73.56,
   "end": 75.02,
   "text": "tips up on its edge..."
  },
  {
   "start": 75.26,
   "end": 76.5,
   "text": "and drops right in."
  },
  {
   "start": 76.94,
   "end": 77.56,
   "text": "I'm okay!\""
  },
  {
   "start": 78.04,
   "end": 79.0,
   "text": "Sam is fine."
  },
  {
   "start": 79.28,
   "end": 79.76,
   "text": "Mostly."
  },
  {
   "start": 80.08,
   "end": 80.62,
   "text": "Day two."
  },
  {
   "start": 80.92,
   "end": 82.28,
   "text": "Joe is extra careful."
  },
  {
   "start": 82.58,
   "end": 83.62,
   "text": "A truck honks,"
  },
  {
   "start": 83.82,
   "end": 86.16,
   "text": "his hands slip, the cover tilts..."
  },
  {
   "start": 86.38,
   "end": 87.62,
   "text": "and drops right in."
  },
  {
   "start": 88.06,
   "end": 88.8,
   "text": "Still okay!\""
  },
  {
   "start": 89.32,
   "end": 89.88,
   "text": "Day three."
  },
  {
   "start": 90.16,
   "end": 90.84,
   "text": "No wind."
  },
  {
   "start": 91.14,
   "end": 91.88,
   "text": "No trucks."
  },
  {
   "start": 92.18,
   "end": 94.4,
   "text": "Just a green light and total focus."
  },
  {
   "start": 94.7,
   "end": 97.16,
   "text": "Joe sets the cover down perfectly flat."
  },
  {
   "start": 97.46,
   "end": 98.08,
   "text": "It fits!"
  },
  {
   "start": 98.42,
   "end": 100.46,
   "text": "He steps on the corner to celebrate."
  },
  {
   "start": 100.8,
   "end": 101.84,
   "text": "The cover flips,"
  },
  {
   "start": 102.1,
   "end": 103.0,
   "text": "turns diagonal,"
  },
  {
   "start": 103.2,
   "end": 104.04,
   "text": "and vanishes."
  },
  {
   "start": 104.32,
   "end": 105.8,
   "text": "Along with Sam's milk."
  },
  {
   "start": 106.28,
   "end": 106.96,
   "text": "Not okay!\""
  }
 ],
