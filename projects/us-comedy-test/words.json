 "lines": [
  {
   "n": 1,
   "speaker": "ben",
   "start": 0.35,
   "end": 2.44,
   "text": "Mia. Who touched the thermostat?"
  },
  {
   "n": 2,
   "speaker": "mia",
   "start": 2.89,
   "end": 3.82,
   "text": "Not me, babe."
  },
  {
   "n": 3,
   "speaker": "ben",
   "start": 4.07,
   "end": 6.88,
   "text": "It was on seventy-four. Seventy-four, Mia!"
  },
  {
   "n": 4,
   "speaker": "mia",
   "start": 7.33,
   "end": 9.35,
   "text": "Weird. Maybe it's the house settling."
  },
  {
   "n": 5,
   "speaker": "ben",
   "start": 9.6,
   "end": 14.72,
   "text": "So I put it back to sixty-eight. Instantly better. I can feel the difference."
  },
  {
   "n": 6,
   "speaker": "mia",
   "start": 14.97,
   "end": 16.65,
   "text": "Wow. Totally."
  },
  {
   "n": 7,
   "speaker": "ben",
   "start": 16.95,
   "end": 19.83,
   "text": "Okay, round two. Who touched it this morning?"
  },
  {
   "n": 8,
   "speaker": "mia",
   "start": 20.08,
   "end": 21.16,
   "text": "Probably the dog."
  },
  {
   "n": 9,
   "speaker": "ben",
   "start": 21.56,
   "end": 22.82,
   "text": "We don't have a dog."
  },
  {
   "n": 10,
   "speaker": "mia",
   "start": 23.07,
   "end": 25.04,
   "text": "Then it's a mystery, honey."
  },
  {
   "n": 11,
   "speaker": "ben",
   "start": 25.29,
   "end": 28.83,
   "text": "Third time this week! I'm setting a boundary with that thermostat."
  },
  {
   "n": 12,
   "speaker": "mia",
   "start": 29.33,
   "end": 34.32,
   "text": "Okay. Babe. Sit down. I gotta tell you something."
  },
  {
   "n": 13,
   "speaker": "ben",
   "start": 35.12,
   "end": 37.17,
   "text": "Did you change the Netflix password again?"
  },
  {
   "n": 14,
   "speaker": "mia",
   "start": 37.97,
   "end": 42.23,
   "text": "The dial you turn every day? It's not connected to anything."
  },
  {
   "n": 15,
   "speaker": "ben",
   "start": 43.03,
   "end": 43.27,
   "text": "What?"
  },
  {
   "n": 16,
   "speaker": "mia",
   "start": 44.27,
   "end": 45.57,
   "text": "It's been fake since 2019."
  },
  {
   "n": 17,
   "speaker": "ben",
   "start": 46.37,
   "end": 48.96,
   "text": "...But I could feel the difference."
  }
 ]
