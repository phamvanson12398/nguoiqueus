 "lines": [
  {
   "n": 1,
   "speaker": "ben",
   "start": 0.35,
   "end": 2.44,
   "text": "Mia. Who touched the thermostat?"
  },
  {
   "n": 2,
   "speaker": "mia",
   "start": 2.64,
   "end": 3.57,
   "text": "Not me, babe."
  },
  {
   "n": 3,
   "speaker": "ben",
   "start": 3.77,
   "end": 6.58,
   "text": "It was on seventy-four. Seventy-four, Mia!"
  },
  {
   "n": 4,
   "speaker": "mia",
   "start": 6.78,
   "end": 8.8,
   "text": "Weird. Maybe it's the house settling."
  },
  {
   "n": 5,
   "speaker": "ben",
   "start": 9.0,
   "end": 14.12,
   "text": "So I put it back to sixty-eight. Instantly better. I can feel the difference."
  },
  {
   "n": 6,
   "speaker": "mia",
   "start": 14.37,
   "end": 16.05,
   "text": "Wow. Totally."
  },
  {
   "n": 7,
   "speaker": "ben",
   "start": 16.35,
   "end": 19.23,
   "text": "Okay, round two. Who touched it this morning?"
  },
  {
   "n": 8,
   "speaker": "mia",
   "start": 19.43,
   "end": 20.51,
   "text": "Probably the dog."
  },
  {
   "n": 9,
   "speaker": "ben",
   "start": 20.91,
   "end": 22.17,
   "text": "We don't have a dog."
  },
  {
   "n": 10,
   "speaker": "mia",
   "start": 22.37,
   "end": 24.34,
   "text": "Then it's a mystery, honey."
  },
  {
   "n": 11,
   "speaker": "ben",
   "start": 24.54,
   "end": 28.08,
   "text": "Third time this week! I'm setting a boundary with that thermostat."
  },
  {
   "n": 12,
   "speaker": "mia",
   "start": 28.58,
   "end": 33.57,
   "text": "Okay. Babe. Sit down. I gotta tell you something."
  },
  {
   "n": 13,
   "speaker": "ben",
   "start": 33.77,
   "end": 35.82,
   "text": "Did you change the Netflix password again?"
  },
  {
   "n": 14,
   "speaker": "mia",
   "start": 36.22,
   "end": 40.48,
   "text": "The dial you turn every day? It's not connected to anything."
  },
  {
   "n": 15,
   "speaker": "ben",
   "start": 40.78,
   "end": 41.02,
   "text": "What?"
  },
  {
   "n": 16,
   "speaker": "mia",
   "start": 42.02,
   "end": 43.32,
   "text": "It's been fake since 2019."
  },
  {
   "n": 17,
   "speaker": "ben",
   "start": 43.92,
   "end": 46.51,
   "text": "...But I could feel the difference."
  }
 ]
