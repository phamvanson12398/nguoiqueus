 "lines": [
  {
   "n": 1,
   "speaker": "ben",
   "start": 0.35,
   "end": 2.43,
   "text": "Mia. Who touched the thermostat?"
  },
  {
   "n": 2,
   "speaker": "mia",
   "start": 2.63,
   "end": 3.61,
   "text": "Not me, babe."
  },
  {
   "n": 3,
   "speaker": "ben",
   "start": 3.81,
   "end": 6.62,
   "text": "It was on seventy-four. Seventy-four, Mia!"
  },
  {
   "n": 4,
   "speaker": "mia",
   "start": 6.82,
   "end": 8.8,
   "text": "Weird. Maybe it's the house settling."
  },
  {
   "n": 5,
   "speaker": "ben",
   "start": 9.0,
   "end": 14.14,
   "text": "So I put it back to sixty-eight. Instantly better. I can feel the difference."
  },
  {
   "n": 6,
   "speaker": "mia",
   "start": 14.39,
   "end": 16.13,
   "text": "Wow. Totally."
  },
  {
   "n": 7,
   "speaker": "ben",
   "start": 16.43,
   "end": 19.35,
   "text": "Okay, round two. Who touched it this morning?"
  },
  {
   "n": 8,
   "speaker": "mia",
   "start": 19.55,
   "end": 20.65,
   "text": "Probably the dog."
  },
  {
   "n": 9,
   "speaker": "ben",
   "start": 21.05,
   "end": 22.35,
   "text": "We don't have a dog."
  },
  {
   "n": 10,
   "speaker": "mia",
   "start": 22.55,
   "end": 24.54,
   "text": "Then it's a mystery, honey."
  },
  {
   "n": 11,
   "speaker": "ben",
   "start": 24.74,
   "end": 28.12,
   "text": "Third time this week! I'm setting a boundary with that thermostat."
  },
  {
   "n": 12,
   "speaker": "mia",
   "start": 28.62,
   "end": 33.53,
   "text": "Okay. Babe. Sit down. I gotta tell you something."
  },
  {
   "n": 13,
   "speaker": "ben",
   "start": 33.73,
   "end": 35.9,
   "text": "Did you change the Netflix password again?"
  },
  {
   "n": 14,
   "speaker": "mia",
   "start": 36.3,
   "end": 40.69,
   "text": "The dial you turn every day? It's not connected to anything."
  },
  {
   "n": 15,
   "speaker": "ben",
   "start": 40.99,
   "end": 41.24,
   "text": "What?"
  },
  {
   "n": 16,
   "speaker": "mia",
   "start": 42.24,
   "end": 43.56,
   "text": "It's been fake since 2019."
  },
  {
   "n": 17,
   "speaker": "ben",
   "start": 44.16,
   "end": 46.75,
   "text": "...But I could feel the difference."
  }
 ]
