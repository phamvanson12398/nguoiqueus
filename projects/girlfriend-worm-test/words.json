 "lines": [
  {
   "n": 1,
   "speaker": "mia",
   "start": 0.35,
   "end": 3.24,
   "text": "Babe, would you still love me if I was a worm?"
  },
  {
   "n": 2,
   "speaker": "ben",
   "start": 3.49,
   "end": 6.19,
   "text": "Of course. I'd build you a tiny worm house."
  },
  {
   "n": 3,
   "speaker": "mia",
   "start": 6.39,
   "end": 7.99,
   "text": "Even if I was slimy?"
  },
  {
   "n": 4,
   "speaker": "ben",
   "start": 8.19,
   "end": 11.28,
   "text": "Extra slimy. I'd carry you in my pocket."
  },
  {
   "n": 5,
   "speaker": "mia",
   "start": 11.48,
   "end": 13.4,
   "text": "And if a bird tried to eat me?"
  },
  {
   "n": 6,
   "speaker": "ben",
   "start": 13.6,
   "end": 15.2,
   "text": "I'd fight the bird. Bare hands."
  },
  {
   "n": 7,
   "speaker": "mia",
   "start": 15.4,
   "end": 17.54,
   "text": "Aww, you really love me."
  },
  {
   "n": 8,
   "speaker": "ben",
   "start": 17.74,
   "end": 21.19,
   "text": "Worm, human, whatever. My love has no limits."
  },
  {
   "n": 9,
   "speaker": "mia",
   "start": 21.49,
   "end": 22.71,
   "text": "No limits at all?"
  },
  {
   "n": 10,
   "speaker": "ben",
   "start": 22.91,
   "end": 26.04,
   "text": "Zero. Unless you touch my pizza. Kidding."
  },
  {
   "n": 11,
   "speaker": "mia",
   "start": 26.54,
   "end": 28.69,
   "text": "Good. Because I ate your pizza."
  },
  {
   "n": 12,
   "speaker": "ben",
   "start": 28.99,
   "end": 30.9,
   "text": "The one I was saving for tonight?"
  },
  {
   "n": 13,
   "speaker": "mia",
   "start": 31.2,
   "end": 32.16,
   "text": "All four slices."
  },
  {
   "n": 14,
   "speaker": "ben",
   "start": 33.16,
   "end": 35.08,
   "text": "Babe... I'm calling the bird."
  },
  {
   "n": 15,
   "speaker": "mia",
   "start": 35.28,
   "end": 36.8,
   "text": "You said no limits!"
  },
  {
   "n": 16,
   "speaker": "ben",
   "start": 37.1,
   "end": 38.82,
   "text": "That was before the pizza."
  }
 ]
}