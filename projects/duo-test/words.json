 "lines": [
  {
   "n": 1,
   "speaker": "jake",
   "start": 0.35,
   "end": 3.33,
   "text": "Okay, babe. Dinner. What do you want?"
  },
  {
   "n": 2,
   "speaker": "emily",
   "start": 3.63,
   "end": 5.31,
   "text": "I don't care. Whatever."
  },
  {
   "n": 3,
   "speaker": "jake",
   "start": 5.56,
   "end": 6.2,
   "text": "Chipotle?"
  },
  {
   "n": 4,
   "speaker": "emily",
   "start": 6.45,
   "end": 8.94,
   "text": "We literally had Chipotle on Tuesday."
  },
  {
   "n": 5,
   "speaker": "jake",
   "start": 9.24,
   "end": 10.95,
   "text": "Okay... Olive Garden?"
  },
  {
   "n": 6,
   "speaker": "emily",
   "start": 11.2,
   "end": 13.81,
   "text": "Too heavy. I have the gym tomorrow."
  },
  {
   "n": 7,
   "speaker": "jake",
   "start": 14.06,
   "end": 14.46,
   "text": "Sushi?"
  },
  {
   "n": 8,
   "speaker": "emily",
   "start": 14.76,
   "end": 16.33,
   "text": "Hmm... not feeling it."
  },
  {
   "n": 9,
   "speaker": "jake",
   "start": 16.58,
   "end": 18.15,
   "text": "Thai? Your Pad Thai place?"
  },
  {
   "n": 10,
   "speaker": "emily",
   "start": 18.4,
   "end": 21.23,
   "text": "On a Friday? That's a forty-five minute wait."
  },
  {
   "n": 11,
   "speaker": "jake",
   "start": 21.83,
   "end": 23.75,
   "text": "Okay. You pick."
  },
  {
   "n": 12,
   "speaker": "emily",
   "start": 24.0,
   "end": 25.89,
   "text": "I told you. I don't care."
  },
  {
   "n": 13,
   "speaker": "jake",
   "start": 26.19,
   "end": 29.65,
   "text": "Babe, you just vetoed four restaurants. That's not 'I don't care.'"
  },
  {
   "n": 14,
   "speaker": "emily",
   "start": 29.9,
   "end": 31.53,
   "text": "Then pick something reasonable!"
  },
  {
   "n": 15,
   "speaker": "jake",
   "start": 31.98,
   "end": 35.12,
   "text": "Fine. DoorDash. Taco Bell. Ordering it."
  },
  {
   "n": 16,
   "speaker": "emily",
   "start": 35.37,
   "end": 37.11,
   "text": "Taco Bell?! Are you serious?"
  },
  {
   "n": 17,
   "speaker": "jake",
   "start": 37.56,
   "end": 38.84,
   "text": "Got a better idea?"
  },
  {
   "n": 18,
   "speaker": "emily",
   "start": 39.64,
   "end": 43.0,
   "text": "...Ooh. What about burgers? In-N-Out by our place?"
  },
  {
   "n": 19,
   "speaker": "emily",
   "start": 44.3,
   "end": 44.58,
   "text": "What?"
  },
  {
   "n": 20,
   "speaker": "jake",
   "start": 45.38,
   "end": 49.73,
   "text": "First thing I said in the car... 'In-N-Out?' And you said, 'Eh, we'll see.'"
  },
  {
   "n": 21,
   "speaker": "emily",
   "start": 50.53,
   "end": 53.27,
   "text": "Okay, but now it's MY idea. Let's go."
  },
  {
   "n": 22,
   "speaker": "jake",
   "start": 53.77,
   "end": 55.65,
   "text": "Next time, I'm recording you."
  },
  {
   "n": 23,
   "speaker": "emily",
   "start": 55.95,
   "end": 57.96,
   "text": "Oh, and get extra fries, babe."
  },
  {
   "n": 24,
   "speaker": "jake",
   "start": 58.46,
   "end": 61.13,
   "text": "Wait. I thought you had the gym tomorrow?"
  },
  {
   "n": 25,
   "speaker": "emily",
   "start": 62.03,
   "end": 63.82,
   "text": "Exactly. They're YOUR fries."
  },
  {
   "n": 26,
   "speaker": "jake",
   "start": 64.82,
   "end": 66.38,
   "text": "...I'm getting two."
  }
 ]
}